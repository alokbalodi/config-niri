{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "lock",
    "action" : "/home/alokkk/.config/niri/scripts/lock-screen",
    "text" : "Lock",
    "keybind" : ""
}
{
    "label" : "logout",
    "action" : "niri msg action quit",
    "text" : "Logout",
    "keybind" : ""
}
{
    "label": "integrated",
    "action": "sudo envycontrol -s integrated && notify-send 'GPU set to Integrated, rebooting...' && sleep 2 && systemctl reboot",
    "text": "Integrated GPU",
    "keybind": "i"
}
{
    "label": "hybrid",
    "action": "sudo envycontrol -s hybrid && notify-send 'GPU set to Hybrid, rebooting...' && sleep 2 && systemctl reboot",
    "text": "Hybrid GPU",
    "keybind": "h"
}

