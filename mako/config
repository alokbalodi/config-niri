# --- Placement ---
anchor=top-right
margin=15

# --- Size ---
width=320
height=110

# --- Appearance ---
background-color=#11111bcc
text-color=#cdd6f4

border-size=1
border-color=#89b4fa
border-radius=8

# --- Font ---
font=JetBrainsMono Nerd Font 11

# --- Spacing ---
padding=12

# --- Behavior ---
default-timeout=4000
ignore-timeout=0

# --- Icons ---
icons=1
max-icon-size=32

# --- Grouping ---
group-by=app-name

# --- Urgency colors ---
[urgency=low]
border-color=#a6e3a1

[urgency=normal]
border-color=#89b4fa

[urgency=critical]
border-color=#f38ba8
background-color=#302030cc
