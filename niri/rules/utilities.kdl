// =====================================================
// Audio
// =====================================================

window-rule {
    match app-id="org.pulseaudio.pavucontrol"

    open-floating true

    default-column-width {
        fixed 800
    }

    default-window-height {
        fixed 500
    }
}

// =====================================================
// Networking
// =====================================================

window-rule {
    match app-id="blueman-manager"

    open-floating true

    default-column-width {
        fixed 700
    }

    default-window-height {
        fixed 500
    }
}

window-rule {
    match app-id="nm-connection-editor"

    open-floating true

    default-column-width {
        fixed 700
    }

    default-window-height {
        fixed 500
    }
}

// =====================================================
// Appearance
// =====================================================

window-rule {
    match app-id="waypaper"

    open-floating true

    default-column-width {
        fixed 900
    }

    default-window-height {
        fixed 700
    }
}

// =====================================================
// Utilities
// =====================================================

window-rule {
    match app-id="filesearch"

    open-floating true

    default-column-width {
        fixed 800
    }

    default-window-height {
        fixed 500
    }
}
