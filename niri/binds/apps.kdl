binds {

    //
    // Applications
    //

    // Terminal
    Alt+T { spawn "kitty"; }

    // File Manager
    Mod+E { spawn "thunar"; }

    // Application Launcher
    Alt+Space {
        spawn "fuzzel";
    }

    // Web Browser
    Mod+B { spawn "firefox"; }

    // Password Manager
    Ctrl+B { spawn "bitwarden-desktop"; }

    //
    // Utilities
    //

    // Wallpaper Manager
    Mod+W { spawn "waypaper"; }

    // File Search
    Mod+Space {
        spawn "kitty" "--title" "filesearch" "--class" "filesearch" "-e" "/home/alokkk/.config/niri/scripts/filesearch.sh";
    }

    // IP Update
    Mod+I {
        spawn "~/.config/niri/scripts/network/ip-update.sh";
    }

    // Keybind Cheatsheet
    Mod+Slash {
        spawn "~/.config/niri/scripts/keybind/keybind-cheatsheet.sh";
    }

    // Toggle Follow Mode
    Mod+A {
        spawn "sh" "-c" "nirius toggle-follow-mode && notify-send 'Niri' 'Follow mode toggled'";
    }
}
