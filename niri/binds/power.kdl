binds {

    //
    // Session
    //

    // Lock Screen
    Mod+L {
        spawn "~/.config/niri/scripts/lock-screen";
    }

    // Toggle Auto Lock
    Mod+F12 {
        spawn "~/.config/niri/scripts/idle-toggle.sh";
    }

    // Logout / Shutdown Menu
    Ctrl+F4 {
        spawn "wlogout";
    }

    //
    // Power Profiles
    //

    // Power Saver
    Mod+Ctrl+P {
        spawn "sh" "-c" "powerprofilesctl set power-saver && notify-send 'Power Profile' 'Power Saver enabled'";
    }

    // Balanced
    Mod+Ctrl+B {
        spawn "sh" "-c" "powerprofilesctl set balanced && notify-send 'Power Profile' 'Balanced enabled'";
    }
}
